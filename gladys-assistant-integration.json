                "es": "Filtro de la aspiradora (3 mes(es))"
              }
            },
            {
              "value": "descaling",
              "label": {
                "en": "Descaling (2 month(s))",
                "fr": "Détartrage (2 mois)",
                "de": "Entkalken (2 Monat(e))",
                "es": "Descalcificación (2 mes(es))"
              }
            },
            {
              "value": "smoke_detectors",
              "label": {
                "en": "Smoke detector batteries (1 year(s))",
                "fr": "Piles des détecteurs de fumée (1 an(s))",
                "de": "Rauchmelder-Batterien (1 Jahr(e))",
                "es": "Pilas de los detectores de humo (1 año(s))"
              }
            },
            {
              "value": "air_conditioning",
              "label": {
                "en": "Air conditioning service (1 year(s))",
                "fr": "Entretien de la climatisation (1 an(s))",
                "de": "Klimaanlagen-Wartung (1 Jahr(e))",
                "es": "Revisión del aire acondicionado (1 año(s))"
              }
            },
            {
              "value": "hood_filter",
              "label": {
                "en": "Cooker hood filter (3 month(s))",
                "fr": "Filtre de la hotte (3 mois)",
                "de": "Dunstabzugsfilter (3 Monat(e))",
                "es": "Filtro de la campana (3 mes(es))"
              }
            },
            {
              "value": "water_filter",
              "label": {
                "en": "Water filter cartridge (1 month(s))",
                "fr": "Cartouche filtrante (1 mois)",
                "de": "Wasserfilterkartusche (1 Monat(e))",
                "es": "Cartucho del filtro de agua (1 mes(es))"
              }
            },
            {
              "value": "gutters",
              "label": {
                "en": "Gutter cleaning (1 year(s))",
                "fr": "Nettoyage des gouttières (1 an(s))",
                "de": "Dachrinnenreinigung (1 Jahr(e))",
                "es": "Limpieza de canalones (1 año(s))"
              }
            },
            {
              "value": "septic_tank",
              "label": {
                "en": "Septic tank emptying (4 year(s))",
                "fr": "Vidange de la fosse septique (4 an(s))",
                "de": "Klärgrubenentleerung (4 Jahr(e))",
                "es": "Vaciado de la fosa séptica (4 año(s))"
              }
            },
            {
              "value": "fire_extinguisher",
              "label": {
                "en": "Fire extinguisher check (1 year(s))",
                "fr": "Vérification de l'extincteur (1 an(s))",
                "de": "Feuerlöscherprüfung (1 Jahr(e))",
                "es": "Revisión del extintor (1 año(s))"
              }
            }
          ]
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Name of the task",
            "fr": "Nom de la tâche",
            "de": "Name der Aufgabe",
            "es": "Nombre de la tarea"
          },
          "description": {
            "en": "Empty: the name of the suggested task.",
            "fr": "Vide : le nom de la tâche proposée.",
            "de": "Leer: der Name der vorgeschlagenen Aufgabe.",
            "es": "Vacío: el nombre de la tarea propuesta."
          },
          "placeholder": {
            "en": "e.g. Pellet stove service",
            "fr": "ex. Entretien du poêle",
            "de": "z. B. Pelletofen-Wartung",
            "es": "p. ej. Revisión de la estufa"
          }
        },
        {
          "key": "every",
          "type": "number",
          "required": false,
          "min": 1,
          "max": 120,
          "label": {
            "en": "Every (number)",
            "fr": "Tous les (nombre)",
            "de": "Alle (Anzahl)",
            "es": "Cada (número)"
          },
          "description": {
            "en": "With the unit below. Empty: the period of the suggested task.",
            "fr": "Avec l'unité ci-dessous. Vide : la période de la tâche proposée.",
            "de": "Mit der Einheit unten. Leer: der Zeitraum der vorgeschlagenen Aufgabe.",
            "es": "Con la unidad de abajo. Vacío: el periodo de la tarea propuesta."
          }
        },
        {
          "key": "unit",
          "type": "select",
          "required": false,
          "label": {
            "en": "Unit",
            "fr": "Unité",
            "de": "Einheit",
            "es": "Unidad"
          },
          "options": [
            {
              "value": "days",
              "label": {
                "en": "days",
                "fr": "jours",
                "de": "Tage",
                "es": "días"
              }
            },
            {
              "value": "weeks",
              "label": {
                "en": "weeks",
                "fr": "semaines",
                "de": "Wochen",
                "es": "semanas"
              }
            },
            {
              "value": "months",
              "label": {
                "en": "months",
                "fr": "mois",
                "de": "Monate",
                "es": "meses"
              }
            },
            {
              "value": "years",
              "label": {
                "en": "years",
                "fr": "ans",
                "de": "Jahre",
                "es": "años"
              }
            }
          ]
        },
        {
          "key": "last_done",
          "type": "string",
          "required": false,
          "label": {
            "en": "Last done",
            "fr": "Dernière fois faite",
            "de": "Zuletzt erledigt",
            "es": "Última vez hecha"
          },
          "description": {
            "en": "2026-03-14, 14/03/2026, or -N for N days ago. Empty: today.",
            "fr": "2026-03-14, 14/03/2026, ou -N pour il y a N jours. Vide : aujourd'hui.",
            "de": "2026-03-14, 14.03.2026 oder -N für vor N Tagen. Leer: heute.",
            "es": "2026-03-14, 14/03/2026, o -N para hace N días. Vacío: hoy."
          },
          "placeholder": {
            "en": "e.g. 2026-03-14",
            "fr": "ex. 14/03/2026",
            "de": "z. B. 14.03.2026",
            "es": "p. ej. 14/03/2026"
          }
        },
        {
          "key": "notice_days",
          "type": "number",
          "required": false,
          "min": 0,
          "max": 365,
          "label": {
            "en": "Notice (days)",
            "fr": "Délai de prévenance (jours)",
            "de": "Vorwarnzeit (Tage)",
            "es": "Aviso previo (días)"
          },
          "description": {
            "en": "Due soon this many days before the due date. Empty: the one of the suggested task, else 7.",
            "fr": "Bientôt dû ce nombre de jours avant l'échéance. Vide : celui de la tâche proposée, sinon 7.",
            "de": "So viele Tage vor der Fälligkeit bald fällig. Leer: die der vorgeschlagenen Aufgabe, sonst 7.",
            "es": "Próximo a vencer estos días antes del vencimiento. Vacío: el de la tarea propuesta, si no 7."
          }
        }
      ]
