{
  "manifest_version": 1,
  "type": "device",
  "name": "Maintenance reminders",
  "description": {
    "en": "Recurring home maintenance (boiler, filters, chimney…): days left, reminders, Done button.",
    "fr": "Entretiens récurrents (chaudière, filtres, ramonage…) : jours restants, rappels, bouton Fait.",
    "de": "Wiederkehrende Wartung (Heizung, Filter, Kamin…): Resttage, Erinnerungen, Erledigt-Taste.",
    "es": "Mantenimiento periódico (caldera, filtros, chimenea…): días restantes, avisos, botón Hecho."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-entretien:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-entretien/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your maintenance tasks",
        "fr": "Vos tâches d'entretien",
        "de": "Deine Wartungsaufgaben",
        "es": "Sus tareas de mantenimiento"
      },
      "description": {
        "en": "Create a task with the buttons below (a suggested one, or your own), then add it in the Discovery tab: it becomes a device with its days left, for the dashboard (Upcoming maintenance widget) and the scenes. Everything stays in Gladys.",
        "fr": "Créez une tâche avec les boutons ci-dessous (une proposée, ou la vôtre), puis ajoutez-la dans l'onglet Découverte : elle devient un appareil avec ses jours restants, pour le tableau de bord (widget Prochains entretiens) et les scènes. Tout reste dans Gladys.",
        "de": "Erstelle eine Aufgabe mit den Schaltflächen unten (eine vorgeschlagene oder deine eigene) und füge sie im Tab Erkennung hinzu: So wird sie zu einem Gerät mit ihren Resttagen, für das Dashboard (Widget Nächste Wartungen) und die Szenen. Alles bleibt in Gladys.",
        "es": "Cree una tarea con los botones de abajo (una propuesta o la suya) y luego añádala en la pestaña Descubrimiento: se convierte en un dispositivo con sus días restantes, para el panel (widget Próximos mantenimientos) y las escenas. Todo se queda en Gladys."
      }
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features when a task is added, dates and texts sent to scenes.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout d'une tâche, dates et textes envoyés aux scènes.",
        "de": "Namen der Funktionen beim Hinzufügen einer Aufgabe, Daten und an Szenen gesendete Texte.",
        "es": "Nombres de las funciones al añadir una tarea, fechas y textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "create_task",
      "label": {
        "en": "Create or change a task",
        "fr": "Créer ou modifier une tâche",
        "de": "Aufgabe erstellen oder ändern",
        "es": "Crear o modificar una tarea"
      },
      "description": {
        "en": "Choose a suggested task, or type a name and a period. A task of the same name is changed instead. Then add it in Discovery.",
