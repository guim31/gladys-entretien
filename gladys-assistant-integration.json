      "description": {
        "en": "Deletes the task and its history, for good. Type its exact name to confirm.",
        "fr": "Supprime la tâche et son historique, définitivement. Saisissez son nom exact pour confirmer.",
        "de": "Löscht die Aufgabe und ihren Verlauf endgültig. Gib zur Bestätigung ihren genauen Namen ein.",
        "es": "Elimina la tarea y su historial, de forma definitiva. Escriba su nombre exacto para confirmar."
      },
      "fields": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "label": {
            "en": "Name of the task",
            "fr": "Nom de la tâche",
            "de": "Name der Aufgabe",
            "es": "Nombre de la tarea"
          }
        }
      ]
    },
    {
